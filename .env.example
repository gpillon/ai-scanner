SCANNER_TOKEN=change-me
# Opens the admin pages (Providers, Models); without it, administration is disabled. Must differ from SCANNER_TOKEN.
# SCANNER_ADMIN_TOKEN=change-me-too
# Encrypts the Provider API keys stored in the database (at least 16 characters).
# SCANNER_SECRET_KEY=a-long-random-string
# Seeds the Model Pool on the FIRST start only; afterwards manage it from the admin pages.
SCANNER_MODELS=[{"id":"anthropic/claude-sonnet-5-5","provider":"anthropic"}]
# SCANNER_DEFAULT_MODEL=anthropic/claude-sonnet-5-5   (defaults to the first model)
# SCANNER_RUNNER=auto     (auto: kubernetes inside a pod, podman elsewhere; fake writes a placeholder Report)
# SCANNER_AGENT_IMAGE=localhost/ai-scanner-agent:latest
# SCANNER_AGENT_ENV=ANTHROPIC_API_KEY   (server variables passed to the agent)
# SCANNER_UI_DIR=ui/dist
# SCANNER_DATA_DIR=data
# SCANNER_DEFAULT_LANGUAGE=en
# SCANNER_MAX_ARCHIVE_MB=200
# SCANNER_MAX_INSTRUCTIONS_LENGTH=2000
# SCANNER_RETENTION_DAYS=365
# SCANNER_SWEEP_INTERVAL_MINUTES=60
# SCANNER_MAX_ATTEMPTS=3
# SCANNER_ATTEMPT_TIMEOUT_MINUTES=20
# SCANNER_SCAN_TIMEOUT_MINUTES=60
# SCANNER_CONCURRENCY=2
# PORT=3000
