/data/
/storage/
/uploads/
/workspaces/
/jobs/
/artifacts/
/tmp/
*.zip
!**/fixtures/**/*.zip
!**/testdata/**/*.zip

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Node / TypeScript ---
node_modules/
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
.turbo/
.cache/
.eslintcache
.npm/
.yarn/*
!.yarn/releases
!.yarn/plugins

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
